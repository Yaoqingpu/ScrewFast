# ------------------------------------------------
# FerruleX environment variables
# Copy this file to .env and fill in values. All are optional:
# features that have no value are simply not rendered.
# ------------------------------------------------

# Google Analytics 4 measurement ID (format G-XXXXXXXXXX).
# When set, GA4 loads in MainLayout and starts tracking pageviews.
PUBLIC_GA4_ID=

# RFQ / newsletter form backend (Cloudflare Pages Function at functions/api/contact.ts).
# The form posts to /api/contact/ on the same origin. Two delivery backends:
#
# --- Backend 1 (preferred): Cloudflare Email Service, no SMTP account needed.
# Step 1: Dashboard → Compute & AI → Email Service → Email Sending → Onboard
#         ferrulex.com (auto-adds the SPF/DKIM DNS records).
# Step 2: Create an API token with "Email Sending" permission
#         (My Profile → API Tokens) and store it:
#   wrangler pages secret put EMAIL_API_TOKEN
# or in the Pages dashboard (Workers & Pages → ferrulex → Settings → Variables and Secrets).
EMAIL_API_TOKEN=

# Optional: account ID when sending from a different Cloudflare account.
# CLOUDFLARE_ACCOUNT_ID=
#
# --- Backend 2 (fallback): plain SMTP over Cloudflare TCP sockets.
# Use any mailbox that offers SMTP — e.g. your Gmail with an app password:
#   wrangler pages secret put SMTP_HOST   # smtp.gmail.com
#   wrangler pages secret put SMTP_USER   # your@gmail.com
#   wrangler pages secret put SMTP_PASS   # 16-digit Gmail app password
# Without any backend configured the endpoint returns a clear "not connected"
# message instead of silently dropping submissions.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Optional: sender address on outgoing mail (default rfq@ferrulex.com for
# backend 1, SMTP_USER for backend 2). Must be on the onboarded domain.
MAIL_FROM=

# Optional: inbox that receives submissions (default sales@ferrulex.com
# for backend 1, SMTP_USER for backend 2).
RFQ_TO_EMAIL=

# Email address shown as sender / fallback in the layout footer.
PUBLIC_SALES_EMAIL=sales@ferrulex.com
