# ------------------------------------------------
# FerruleX environment variables
# Copy this file to .env and fill in values. All are optional:
# features that have no value are simply not rendered.
# ------------------------------------------------

# Google Analytics 4 measurement ID (format G-XXXXXXXXXX).
# When set, GA4 loads in MainLayout and starts tracking pageviews.
PUBLIC_GA4_ID=

# RFQ / contact form endpoint. Any service that accepts a
# application/x-www-form-urlencoded POST (Formspree, Basin,
# Getform, your own SiteGround-hosted PHP endpoint, etc).
# When blank, the form runs in demo mode (shows a 'not connected'
# message instead of submitting).
PUBLIC_FORM_ENDPOINT=

# Optional: destination route the demo forms point at when no
# endpoint is configured.
PUBLIC_FORM_DESTINATION=

# Email address shown as sender / fallback in the layout footer.
PUBLIC_SALES_EMAIL=sales@ferrulex.com
