---
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';
import catalogOverview from '@images/apps/features-piping.jpg';
import corrugatedHose from '@images/apps/services-quote.jpg';
import compressionConnector from '@images/apps/app-instrument.jpg';
import compressionElbow from '@images/apps/services-oem.jpg';
import baTube from '@images/apps/app-pipes.jpg';
import ballValve from '@images/apps/app-lab.jpg';
import castStraight from '@images/apps/app-refinery.jpg';
import castValve from '@images/apps/app-marine.jpg';
import { SITE } from '@data/constants';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: 'Product selection support',
    subTitle:
      'Not sure whether you need stainless steel compression fittings, a ball valve or a needle valve? Share your tube OD, thread standard (NPT / G / metric), media and pressure. Our factory maps the catalog to your drawing and recommends SS304 or SS316 before you order.',
    single: false,
    imgOne: catalogOverview,
    imgOneAlt: 'Stainless steel fittings and tube — catalog overview spread for RFQ planning',
    imgTwo: corrugatedHose,
    imgTwoAlt: 'Corrugated stainless hose with male and female thread — catalog sample',
  },
  {
    isRightSection: false,
    title: 'OEM and project quoting',
    subTitle:
      'As a factory we quote fittings and valves for OEM panels and plant work. Send the size list or the BOM. The reply states quantity, days and packing. Stocked sizes can move while a custom line is still in the shop.',
    img: compressionConnector,
    imgAlt: 'Compression tube-to-male connector — catalog sample for OEM RFQs',
    btnExists: true,
    btnTitle: 'Request a Quote',
    btnURL: '/contact/',
  },
  {
    isRightSection: true,
    title: 'Mixed threads and materials',
    subTitle:
      'Need metric compression fittings on one end and NPT on the other? Or SS316 for corrosive media and SS304 for utility air? We combine compression, threaded, weld and quick-screw series in-house so your manifold stays consistent.',
    single: false,
    imgOne: compressionElbow,
    imgOneAlt: 'Compression male elbow connector — catalog sample',
    imgTwo: baTube,
    imgTwoAlt: 'Precision-machined stainless fittings — custom CNC parts',
  },
  {
    isRightSection: false,
    title: 'After-sales documentation',
    subTitle:
      'On request we support material notes, packing lists and shipment photos for overseas buyers. Ask for certificates when you submit the RFQ so our factory can prepare the file set with your order.',
    img: ballValve,
    imgAlt: 'Female-threaded stainless steel ball valve — catalog sample',
  },
  {
    isRightSection: true,
    title: 'Custom and non-standard parts',
    subTitle:
      'Catalog sizes cover most instrumentation needs. For non-standard elbows, tees, hose ends or cast bodies, send a drawing. We review manufacturability in-house and return a quotation with lead time.',
    single: false,
    imgOne: castStraight,
    imgOneAlt: 'Instrument manifold with stainless fittings and valves — made-to-order assembly',
    imgTwo: castValve,
    imgTwoAlt: 'Custom-machined stainless fittings — non-standard production',
    btnExists: true,
    btnTitle: 'Send a drawing',
    btnURL: '/contact/',
  },
];

const pageTitle: string = `Services | ${SITE.title}`;
const metaDescription =
  'Factory RFQ support for stainless steel fittings, compression fittings, ball valves and needle valves. Fast delivery on stocked sizes for export OEM buyers.';
const ogTitle = `Services | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${SITE.url}/services/`,
    url: `${SITE.url}/services/`,
    name: ogTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description_short,
    },
    inLanguage: 'en-US',
  }}
>
  <MainSection
    title="Factory services for export buyers"
    subTitle={`${SITE.title} is a Nanjing stainless fittings factory. We quote compression fittings, valves, hose and tube from one plant — price, lead time and packing. There is no checkout.`}
  />

  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <FeaturesStats
    title="How factory sourcing works"
    subTitle="Browse the stainless steel fittings catalog, shortlist SKUs, then send sizes and quantity. We reply with factory price, lead time and packing — stocked sizes ship fast."
    mainStatTitle="Factory"
    mainStatSubTitle="direct manufacturing — not a pure trading desk"
    stats={[
      { stat: 'Fast delivery', description: 'stocked SS304 / SS316 sizes ship quickly after confirmation' },
      { stat: 'OEM ready', description: 'mixed threads, custom ends and non-standard machining in-house' },
      { stat: 'Export', description: 'packing and documents confirmed with each quotation' },
    ]}
  />
</MainLayout>
