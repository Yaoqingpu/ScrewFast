---
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import heroImage from '@images/apps/hero-plant-landscape.jpg';
import faqs from '@data/faqs.json';
import featureImage from '@images/apps/features-piping.jpg';
import construction from '@images/products/p02-01-ss-corrugated-hose-male-female-thread.jpg';
import tools from '@images/products/p04-11-compression-male-elbow-connector.jpg';
import dashboard from '@images/products/p09-51-female-threaded-ball-valve.jpg';
import needle from '@images/products/p10-61-straight-compression-needle-valve.jpg';
import cast from '@images/products/p13-79-investment-cast-elbow.jpg';
import quickScrew from '@images/products/p06-28-quick-screw-straight-connector.jpg';
import { SITE } from '@data/constants';
---

<MainLayout
  title="Stainless Steel Fittings & Valves Factory | FerruleX"
  customDescription={SITE.description}
  customOgTitle="Stainless Steel Fittings & Valves Factory | FerruleX"
>
  <HeroSection
    title="Stainless steel fittings and valves"
    badge="FerruleX · Nanjing factory · Export worldwide"
    subTitle="Our brand is FerruleX. For many years one plant has run compression fittings, ball valves, needle valves, check valves and corrugated hose — SS304, SS316, SS316L, metric and inch. Send one size list. The reply is a quote with price, a firm ship date and export packing. No logins, no cart."
    facts={[
      { label: 'Stocked sizes', value: 'Ship in 5–7 days' },
      { label: 'Grades', value: 'SS304 · SS316 · SS316L' },
      { label: 'Payment', value: 'T/T · L/C at sight' },
    ]}
    primaryBtn="View Products"
    primaryBtnURL="/products/"
    secondaryBtn="Request a Quote"
    secondaryBtnURL="/contact/"
    src={heroImage}
    alt="Stainless steel ball valve with lever handle, made in the FerruleX factory"
  />


  <FeaturesGeneral
    title="The order, in four lines"
    subTitle="Every quote answers the same four things: how fast, what to send, how to pay, and what is not included until we confirm it."
    src={featureImage}
    alt="Stainless compression fittings from the FerruleX / Shengquan catalog"
    features={[
      {
        heading: '5–7 days',
        content:
          'Stocked SS304 and SS316 sizes ship after you confirm the quote. The date is on the quotation — not a promise on this page.',
        svg: 'dashboard',
      },
      {
        heading: '15–25 days',
        content:
          'Made-to-order parts and large lots. That is production time only — sea freight is extra and depends on the port you name.',
        svg: 'verified',
      },
      {
        heading: 'What to send',
        content:
          'Tube OD or thread size, grade, quantity, destination. Add a drawing if the two ends are different.',
        svg: 'tools',
      },
      {
        heading: 'How you pay',
        content:
          'T/T, about 30% with the order, balance before shipment. L/C at sight on larger orders. FOB Shanghai or Ningbo.',
        svg: 'house',
      },
    ]}
  />

  <FeaturesNavs
    title="The catalog in three groups"
    tabs={[
      {
        heading: 'Compression fittings',
        content:
          'Connectors, elbows, tees, unions, bulkheads for metric and inch tube. Port threads in NPT, G, BSPT or metric. Every quote starts from the tube OD plus the port thread.',
        svg: 'tools',
        src: tools,
        alt: 'Double-ferrule stainless steel compression elbow — catalog sample',
        first: true,
      },
      {
        heading: 'Valves',
        content:
          'Ball valves shut off. Needle valves meter. Check valves hold one direction. Ends: compression, female thread or weld. Pressure class is confirmed on the quote — the 2-piece threaded series runs PN16, 1/8 inch to 4 inch.',
        svg: 'dashboard',
        src: dashboard,
        alt: 'Female-threaded stainless steel ball valve — catalog sample',
        second: true,
      },
      {
        heading: 'Hose and tube',
        content:
          'Corrugated hose absorbs vibration and heat movement between fixed ports. BA tube, coil tube and cast fittings complete the line. Custom ends need a drawing — and get their own lead time.',
        svg: 'house',
        src: construction,
        alt: 'Corrugated stainless steel hose with threaded ends — catalog sample',
      },
    ]}
  />

  <FeaturesNavs
    title="More lines from the same plant"
    idPrefix="tabs-more-lines"
    tabs={[
      {
        heading: 'Quick-screw',
        content:
          'Nut-and-ferrule bite for air and light-fluid panels. Straight, female, union, elbow, tee and bulkhead — separate from push-to-connect.',
        svg: 'tools',
        src: quickScrew,
        alt: 'Quick-screw straight connector — catalog sample',
        first: true,
      },
      {
        heading: 'Needle valves',
        content:
          'Metering, sampling and gauge isolation. Compression or female thread. Not a substitute for a ball valve on full-flow shutoff.',
        svg: 'dashboard',
        src: needle,
        alt: 'Straight compression needle valve — catalog sample',
        second: true,
      },
      {
        heading: 'Cast fittings',
        content:
          'Investment-cast elbows, tees, straights and valve bodies when the BOM needs a cast shape. Grade and ends on the RFQ.',
        svg: 'house',
        src: cast,
        alt: 'Investment-cast stainless elbow — catalog sample',
      },
    ]}
  />

  <FAQ title="Frequently<br />asked questions" faqs={faqs} />

  <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-semibold tracking-wide text-blue-700 uppercase dark:text-blue-400">
        About FerruleX
      </p>
      <h2 class="mt-2 text-2xl font-bold text-balance text-neutral-800 sm:text-3xl dark:text-neutral-200">
        A Nanjing factory for stainless fittings and valves
      </h2>
      <p class="mt-4 text-pretty text-neutral-600 dark:text-neutral-400">
        Our brand is FerruleX. For many years we have focused on stainless steel
        compression fittings, ball valves, needle valves, check valves and corrugated
        hose — plus quick-screw, push-to-connect, adapters, plugs and cast parts.
        Grades are SS304, SS316 and SS316L. Browse the catalog, send a size list, and
        get a factory quote. No cart.
      </p>
      <p class="mt-3 text-sm text-neutral-500 dark:text-neutral-500">
        {SITE.address}
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <PrimaryCTA title="About the factory" url="/about/" />
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-x-2 rounded-lg border border-neutral-300 bg-white px-4 py-3 text-sm font-medium text-neutral-800 ring-zinc-500 outline-hidden transition duration-300 hover:bg-neutral-50 focus-visible:ring-3 dark:border-neutral-600 dark:bg-neutral-800 dark:text-neutral-200 dark:hover:bg-neutral-700"
        >
          Request a Quote
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 py-16 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-neutral-900 px-6 py-16 text-center shadow-xl shadow-neutral-900/20 sm:px-16 dark:bg-neutral-900 dark:ring-1 dark:ring-neutral-800">
      {/* Subtle engineering-grid backdrop */}
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:url(/banner-pattern.svg)] [background-size:28px_28px]"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-0 bg-linear-to-t from-neutral-900/60 via-transparent to-transparent"
        aria-hidden="true"
      ></div>

      <div class="relative">
        <h2 class="text-2xl font-bold text-white md:text-4xl">
          Send the size list
        </h2>
        <p class="mx-auto mt-4 max-w-2xl text-neutral-300">
          Size, grade, quantity, destination — four lines is enough to start.
          The reply is a factory quote: price, production days, packing. Stock
          ships in 5–7 days after confirmation; made-to-order runs 15–25 days
          plus freight.
        </p>
        <div class="mt-8 flex justify-center">
          <PrimaryCTA title="Request a Quote" url="/contact/" />
        </div>
      </div>
    </div>
  </section>
</MainLayout>
