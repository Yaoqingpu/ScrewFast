---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import CategoryCard from '@components/ui/cards/CategoryCard.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { SITE } from '@data/constants';
import { PRODUCT_CATEGORIES, categoryPath } from '@data/categories';
import { isEnContent } from '@utils/contentLocale';

const products: CollectionEntry<'products'>[] = await getCollection(
  'products',
  ({ id }) => isEnContent(id)
);

const categories = PRODUCT_CATEGORIES.map(cat => {
  const items = products
    .filter(p => p.data.category === cat.slug)
    .sort((a, b) => a.data.main.id - b.data.main.id);
  return {
    ...cat,
    count: items.length,
    image: items[0]?.data.main.imgCard,
    imageAlt: items[0]?.data.main.imgAlt ?? cat.title,
  };
}).filter(c => c.count > 0);

const pageTitle = `Stainless Steel Fittings Catalog | ${SITE.title}`;
const metaDescription =
  'Browse FerruleX categories: stainless steel compression fittings, ball valves, needle valves, corrugated hose and tube fittings. Request a quote for OEM supply.';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
  structuredData={[
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      '@id': `${SITE.url}/products/`,
      url: `${SITE.url}/products/`,
      name: pageTitle,
      description: metaDescription,
      isPartOf: {
        '@type': 'WebSite',
        url: SITE.url,
        name: SITE.title,
        description: SITE.description_short,
      },
      inLanguage: 'en-US',
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: `${SITE.url}/`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Products',
          item: `${SITE.url}/products/`,
        },
      ],
    },
  ]}
>
  <div class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mb-8 flex flex-col gap-4 sm:mb-12 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-3xl">
        <h1 class="text-2xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-200">
          Stainless steel fittings catalog
        </h1>
        <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
          Pick a category, then open a product for material, ends and how to
          order. Prices stay on the quote. Photos are catalog shots until the
          final product photos are in.
        </p>
      </div>
      <PrimaryCTA title="Request a Quote" url="/contact/" noArrow={true} />
    </div>

    <section class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {categories.map(cat => (
        <CategoryCard
          href={categoryPath(cat.slug)}
          title={cat.shortTitle}
          description={cat.description}
          count={cat.count}
          image={cat.image}
          imageAlt={cat.imageAlt}
        />
      ))}
    </section>
  </div>
</MainLayout>
