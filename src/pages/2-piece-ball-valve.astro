---
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import { SITE } from '@data/constants';

const pageTitle = `Stainless Steel 2-Piece Ball Valve (PN16 304/316L) | ${SITE.title}`;
const metaDescription =
  '2-piece stainless steel ball valves, full port, 304/316L, PN16. Size chart, materials, packing and factory lead times. Request a FerruleX quote — prices on RFQ.';

const specs: [string, string][] = [
  ['Body / ball', '304 or 316L stainless (CF8 / CF8M)'],
  ['Seat / gasket', 'PTFE'],
  ['Stem', '304 stainless steel'],
  ['Handle', 'Stainless lever with plastic grip, lockable'],
  ['Pressure', 'PN16 / 1.6 MPa (232 PSI) — confirm series on RFQ'],
  ['Temperature', '0°C to 100°C typical; ask if media is outside this band'],
  ['Threads', 'BSP, NPT, BSPT, G'],
  ['Port', 'Full bore (full port)'],
  ['Ends', 'Female thread'],
  ['Operation', 'Manual 90° lever, bi-directional'],
  ['Media', 'Water, oil, gas, corrosive liquids (alloy dependent)'],
];

const sizes: [string, string, string, string][] = [
  ['1/8"', 'DN6', '100', 'On request'],
  ['1/4"', 'DN8', '100', 'On request'],
  ['3/8"', 'DN10', '100', 'On request'],
  ['1/2"', 'DN15', '100', 'On request'],
  ['3/4"', 'DN20', '100', 'On request'],
  ['1"', 'DN25', '50', 'On request'],
  ['1-1/4"', 'DN32', '50', 'On request'],
  ['1-1/2"', 'DN40', '50', 'On request'],
  ['2"', 'DN50', '50', 'On request'],
  ['2-1/2"', 'DN65', '20', 'On request'],
  ['3"', 'DN80', '20', 'On request'],
  ['4"', 'DN100', '20', 'On request'],
];

const bom: [string, string, string][] = [
  ['1', 'Body', 'SS 304 / 316L'],
  ['2', 'End cap', 'SS 304 / 316L'],
  ['3', 'Ball', 'SS 304 / 316L'],
  ['4', 'Seat (2)', 'PTFE'],
  ['5', 'Stem', 'SS 304'],
  ['6–7', 'Gland packing / thrust washer', 'PTFE'],
  ['8–10', 'Gland nut, handle nut, spring washer', 'SS 201'],
  ['11–13', 'Handle, sleeve, locking device', 'SS 201 + plastic grip'],
];
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
>
  <article class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <nav class="mb-6 text-sm text-neutral-500 dark:text-neutral-400">
      <a href="/products/" class="hover:text-blue-700">
        Products
      </a>
      <span class="mx-2">/</span>
      <a href="/products/ball-valves/" class="hover:text-blue-700">
        Ball Valves
      </a>
      <span class="mx-2">/</span>
      <span class="text-neutral-800 dark:text-neutral-200">
        2-Piece Ball Valve
      </span>
    </nav>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase tracking-wide text-blue-700">
          Series framework
        </p>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-200">
          Stainless steel 2-piece ball valves
        </h1>
        <p class="mt-4 text-lg text-neutral-600 dark:text-neutral-400">
          Full-port, two-piece body in 304 or 316L for water, oil, gas and
          corrosive liquids. Medium-duty and heavy-duty builds. Working frame:
          PN16, female thread. Formal price is always an RFQ — this page is the
          selection outline.
        </p>
      </div>
      <PrimaryCTA title="Request a Quote" url="/contact/" />
    </div>

    <section class="mt-12">
      <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
        Key features
      </h2>
      <ul class="mt-4 grid gap-2 text-neutral-700 sm:grid-cols-2 dark:text-neutral-300">
        <li>304 / 316L body (CF8 / CF8M)</li>
        <li>2-piece body, full bore</li>
        <li>PTFE seats</li>
        <li>Lockable lever handle</li>
        <li>BSP, NPT, BSPT or G threads</li>
        <li>Install in any orientation</li>
      </ul>
    </section>

    <section class="mt-12 overflow-x-auto">
      <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
        Technical specifications
      </h2>
      <table class="mt-4 w-full min-w-[32rem] text-left text-sm">
        <tbody>
          {specs.map(([k, v]) => (
            <tr class="border-b border-neutral-200 dark:border-neutral-700">
              <th class="w-1/3 py-2 pr-4 font-semibold text-neutral-800 dark:text-neutral-200">
                {k}
              </th>
              <td class="py-2 text-neutral-600 dark:text-neutral-400">{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
        Construction
      </h2>
      <p class="mt-3 max-w-3xl text-neutral-600 dark:text-neutral-400">
        Smooth finish, even wall, machined seats. Heavy-duty series uses a
        thicker wall than medium-duty for tougher duty. Photos and an exploded
        drawing will replace this outline when the catalog shots are ready.
      </p>
    </section>

    <section class="mt-12 overflow-x-auto">
      <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
        Main parts &amp; materials
      </h2>
      <table class="mt-4 w-full min-w-[32rem] text-left text-sm">
        <thead>
          <tr class="border-b border-neutral-300 text-neutral-500 dark:border-neutral-600">
            <th class="py-2 pr-4">No.</th>
            <th class="py-2 pr-4">Part</th>
            <th class="py-2">Material</th>
          </tr>
        </thead>
        <tbody>
          {bom.map(([n, part, mat]) => (
            <tr class="border-b border-neutral-200 dark:border-neutral-700">
              <td class="py-2 pr-4">{n}</td>
              <td class="py-2 pr-4">{part}</td>
              <td class="py-2 text-neutral-600 dark:text-neutral-400">{mat}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
        Two series
      </h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg border border-neutral-200 p-4 dark:border-neutral-700">
          <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
            Series A — medium duty (304)
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            General water, oil and gas. Working pressure up to 1.6 MPa in the
            selection sheet.
          </p>
        </div>
        <div class="rounded-lg border border-neutral-200 p-4 dark:border-neutral-700">
          <h3 class="font-bold text-neutral-800 dark:text-neutral-200">
            Series B — heavy duty (304 / 316L)
          </h3>
          <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">
            Thicker wall for harder service and better corrosion resistance.
            Confirm the duty on the RFQ.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-12 overflow-x-auto">
      <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
        Size chart &amp; typical MOQ
      </h2>
      <p class="mt-2 text-sm text-neutral-500">
        Prices are not listed. MOQ is a starting guide from the selection sheet
        and can be negotiated.
      </p>
      <table class="mt-4 w-full min-w-[36rem] text-left text-sm">
        <thead>
          <tr class="border-b border-neutral-300 text-neutral-500 dark:border-neutral-600">
            <th class="py-2 pr-4">Inch</th>
            <th class="py-2 pr-4">DN</th>
            <th class="py-2 pr-4">Guide MOQ (pcs)</th>
            <th class="py-2">Price</th>
          </tr>
        </thead>
        <tbody>
          {sizes.map(([inch, dn, moq, price]) => (
            <tr class="border-b border-neutral-200 dark:border-neutral-700">
              <td class="py-2 pr-4">{inch}</td>
              <td class="py-2 pr-4">{dn}</td>
              <td class="py-2 pr-4">{moq}</td>
              <td class="py-2">{price}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="mt-12 max-w-3xl">
      <h2 class="text-xl font-bold text-neutral-800 dark:text-neutral-200">
        Ordering
      </h2>
      <ul class="mt-4 list-disc space-y-2 pl-5 text-neutral-700 dark:text-neutral-300">
        <li>
          Delivery: about 5–7 days for stocked items; about 15–25 days for bulk
          / make-to-order.
        </li>
        <li>
          Payment: T/T (typical 30% deposit, balance before shipment) or L/C at
          sight — confirmed on the quotation.
        </li>
        <li>
          Packing: bag + inner carton + export carton; wooden case for large
          lots.
        </li>
        <li>Shipping: FOB Shanghai or Ningbo, or the Incoterm you specify.</li>
        <li>
          Quotation validity: about 30 days unless the reply says otherwise.
        </li>
      </ul>
      <p class="mt-4 text-neutral-600 dark:text-neutral-400">
        More on{' '}
        <a class="text-blue-700 underline" href="/delivery/">
          delivery
        </a>{' '}
        and
        <a class="text-blue-700 underline" href="/quality/">
          quality
        </a>
        . Instrumentation-style compression ball valves stay in the
        <a class="text-blue-700 underline" href="/products/ball-valves/">
          ball valve category
        </a>
        .
      </p>
      <div class="mt-8">
        <PrimaryCTA title="Request a Quote" url="/contact/" />
      </div>
    </section>
  </article>
</MainLayout>
