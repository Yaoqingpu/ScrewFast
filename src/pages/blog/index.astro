---
import MainLayout from '@/layouts/MainLayout.astro';
import CategoryCard from '@components/ui/cards/CategoryCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';
import { BLOG_CATEGORIES, blogCategoryPath, blogHubPath } from '@data/blog_categories';
import { isEnContent } from '@utils/contentLocale';
import appFactory from '@images/apps/app-factory.jpg';
import appMarine from '@images/apps/app-marine.jpg';
import appPipes from '@images/apps/app-pipes.jpg';
import appPanel from '@images/apps/app-panel.jpg';
import featuresPiping from '@images/apps/features-piping.jpg';

const posts = await getCollection('blog', ({ id, filePath }) =>
  isEnContent(id, filePath)
);

const coverBySlug: Record<string, any> = {
  'materials-grades': featuresPiping,
  'threads-standards': appPanel,
  'installation-guides': appPipes,
  'industry-applications': appMarine,
  'factory-export': appFactory,
};

const categories = BLOG_CATEGORIES.map(cat => {
  const count = posts.filter(p => p.data.category === cat.slug).length;
  return {
    ...cat,
    count,
    image: coverBySlug[cat.slug],
  };
});

const pageTitle = `Blog — Stainless Steel Fitting Guides | ${SITE.title}`;
const metaDescription =
  'Factory guides on stainless steel fittings — materials, threads, installation and export delivery from FerruleX.';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={pageTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `${SITE.url}${blogHubPath()}`,
    url: `${SITE.url}${blogHubPath()}`,
    name: pageTitle,
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: SITE.url,
      name: SITE.title,
      description: SITE.description_short,
    },
    inLanguage: 'en-US',
  }}
>
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mb-10 max-w-3xl">
      <h1 class="text-2xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-200">
        Blog
      </h1>
      <p class="mt-3 text-pretty text-neutral-600 dark:text-neutral-400">
        Short factory notes: which grade to pick, which thread you actually have, and how to install a compression fitting without leaking the first joint.
      </p>
    </div>

    <section class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map(cat => (
          <CategoryCard
            href={blogCategoryPath(cat.slug)}
            title={cat.shortTitle}
            description={cat.description}
            count={cat.count}
            image={cat.image}
            imageAlt={cat.title}
          />
        ))
      }
    </section>
  </section>
</MainLayout>
