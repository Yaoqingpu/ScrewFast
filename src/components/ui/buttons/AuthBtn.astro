---
// Destructure the properties from Astro.props
const { title } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title: string;
}
const classes =
  'group inline-flex w-full items-center justify-center gap-x-2 rounded-xl bg-blue-600 px-5 py-3.5 text-sm font-semibold text-white shadow-sm shadow-blue-600/25 transition duration-300 hover:bg-blue-700 hover:shadow-md focus-visible:ring-3 focus-visible:ring-blue-500/40 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-60';
---

{/* Styled submit button with dynamic title and arrow */}
<button type="submit" class={classes}>
  {title}
  <svg
    class="size-4 transition-transform duration-300 group-hover:translate-x-0.5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="m9 18 6-6-6-6"></path>
  </svg>
</button>
