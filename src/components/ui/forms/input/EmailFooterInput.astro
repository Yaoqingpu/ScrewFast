---
const {
  label = 'Email',
  title = 'Subscribe',
  id = 'footer-input',
} = Astro.props;

interface Props {
  label?: string;
  title?: string;
  id?: string;
}

const placeholder = 'Enter your email';
const successMessage =
  'Thanks! (Demo only - wire an email service to collect real subscribers.)';
---

<div class="mt-4 flex flex-col items-center gap-2 rounded-xl bg-neutral-800 p-2 ring-1 ring-neutral-700 sm:flex-row sm:gap-3">
  <div class="w-full">
    <label for={id} class="sr-only">
      {label}
    </label>
    <input
      type="email"
      id={id}
      name="email"
      required
      autocomplete="email"
      class="block w-full rounded-lg border-transparent bg-neutral-900 px-4 py-3 text-sm text-neutral-200 caret-blue-400 placeholder:text-neutral-500 focus:border-blue-500 focus:ring-blue-500 disabled:pointer-events-none disabled:opacity-50"
      placeholder={placeholder}
    />
  </div>
  <button
    type="submit"
    class="inline-flex w-full items-center justify-center gap-x-2 rounded-lg border border-transparent bg-blue-600 p-3 text-sm font-bold whitespace-nowrap text-white ring-zinc-500 outline-hidden transition duration-300 hover:bg-blue-700 focus-visible:ring-3 disabled:pointer-events-none disabled:opacity-50 sm:w-auto dark:ring-zinc-200 dark:focus:ring-1 dark:focus:outline-hidden"
  >
    {title}
  </button>
</div>
<p
  class="mt-2 hidden text-sm text-neutral-400"
  data-demo-status
  aria-live="polite"
  data-success-message={successMessage}
></p>
