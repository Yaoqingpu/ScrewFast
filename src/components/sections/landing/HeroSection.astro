---
// Import the necessary dependencies
import { Image } from 'astro:assets';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import SecondaryCTA from '@components/ui/buttons/SecondaryCTA.astro';

// Define props from Astro
const {
  title,
  subTitle,
  badge,
  facts = [],
  primaryBtn,
  primaryBtnURL,
  secondaryBtn,
  secondaryBtnURL,
  src,
  alt,
} = Astro.props;

// Define TypeScript interface for props
interface Fact {
  label: string;
  value: string;
}

interface Props {
  title: string;
  subTitle?: string;
  badge?: string;
  facts?: Fact[];
  primaryBtn?: string;
  primaryBtnURL?: string;
  secondaryBtn?: string;
  secondaryBtnURL?: string;
  src?: any;
  alt?: string;
}
---

{/* Defining a grid container that holds all the content */}
<section class="relative mx-auto grid max-w-[85rem] gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:items-center md:gap-10 lg:min-h-[76vh] lg:px-8 lg:py-24 2xl:max-w-full">
  {/* Blueprint-style background wash */}
  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-linear-to-b from-blue-50 via-neutral-50 to-transparent dark:from-blue-950/30 dark:via-neutral-950 dark:to-transparent"
    aria-hidden="true"
  ></div>

  {/* Title and description */}
  <div>
    {/* Eyebrow badge */}
    {badge && (
      <p class="mb-5 inline-flex items-center gap-x-2 rounded-full border border-blue-200/80 bg-blue-50 px-3 py-1 text-xs font-semibold tracking-wide text-blue-700 uppercase dark:border-blue-400/20 dark:bg-blue-400/10 dark:text-blue-300">
        <span
          class="inline-block size-1.5 rounded-full bg-blue-600 dark:bg-blue-400"
          aria-hidden="true"
        ></span>
        {badge}
      </p>
    )}
    {/* Each h1 and p tag renders a portion of the title and subTitle defined above */}
    <h1 class="block text-3xl font-bold tracking-tight text-balance text-neutral-800 sm:text-4xl lg:text-6xl lg:leading-tight dark:text-neutral-200">
      {/* About Fragment: https://docs.astro.build/en/basics/astro-syntax/#fragments */}
      <Fragment set:html={title} />
    </h1>
    {subTitle && (
      <p class="mt-4 text-lg leading-relaxed text-pretty text-neutral-600 lg:w-11/12 dark:text-neutral-400">
        {subTitle}
      </p>
    )}
    {/* Action Button Section: This section includes two CTAs with their own styles and URL */}
    <div class="mt-8 grid w-full gap-3 sm:inline-flex">
      {primaryBtn && <PrimaryCTA title={primaryBtn} url={primaryBtnURL} />}
      {secondaryBtn && (
        <SecondaryCTA title={secondaryBtn} url={secondaryBtnURL} />
      )}
    </div>

    {/* Spec facts — the numbers a B2B buyer scans first */}
    {facts.length > 0 && (
      <dl class="mt-10 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-neutral-200/80 bg-neutral-200/80 sm:grid-cols-3 dark:border-neutral-800 dark:bg-neutral-800">
        {facts.map(fact => (
          <div class="bg-neutral-50 px-4 py-3.5 dark:bg-neutral-900">
            <dt class="text-xs font-semibold tracking-wide text-neutral-500 uppercase dark:text-neutral-400">
              {fact.label}
            </dt>
            <dd class="mt-1 text-sm font-semibold text-neutral-800 dark:text-neutral-100">
              {fact.value}
            </dd>
          </div>
        ))}
      </dl>
    )}
  </div>

  {/* Hero Image Section — fills the text column height on md+, aspect ratio reserves space on mobile */}
  <div class="flex w-full">
    <div class="relative aspect-[3/2] w-full overflow-hidden rounded-2xl shadow-xl shadow-neutral-900/10 ring-1 ring-neutral-900/10 md:aspect-auto md:h-full md:min-h-[420px] lg:min-h-[480px] dark:ring-neutral-100/10">
      {src && alt && (
        <Image
          src={src}
          alt={alt}
          class="absolute inset-0 h-full w-full object-cover object-center"
          widths={[480, 812, 1218]}
          sizes="(max-width: 768px) 100vw, 50vw"
          draggable={'false'}
          loading="eager"
          fetchpriority="high"
          width={812}
          height={541}
          format={'avif'}
        />
      )}
    </div>
  </div>
</section>
