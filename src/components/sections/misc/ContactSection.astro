---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';

const copy = {
  title: 'Request a Quote (RFQ)',
  subTitle:
    'Paste your size list — tube OD or thread, grade, quantity, destination port. A factory quote comes back in 1–2 business days: price, ship date, packing. No account, no charge, no obligation.',
  formTitle: 'RFQ form',
  formSubTitle:
    'One line per item is enough: size, material, quantity, port. Attach a drawing when the two ends differ.',
  name: 'Name',
  email: 'Work Email',
  company: 'Company',
  topic: 'Topic',
  message: 'Size list / Message',
  send: 'Submit RFQ',
  successMessage:
    'Thanks — your RFQ is in the inbox. We reply in 1–2 business days.',
  catalogHeading: 'Product catalog',
  catalogContent:
    '105 stocked-and-quoted lines: compression fittings, ball valves, needle valves, corrugated hose.',
  catalogLink: 'View products',
  faqHeading: 'FAQ',
  faqContent:
    'Quick answers on materials, threads, MOQ and how RFQ ordering works.',
  faqLink: 'Visit FAQ',
  officeHeading: 'Factory address',
  officeContent:
    'FerruleX — Nanjing stainless steel fittings factory. Export RFQ and courier delivery.',
  officeAddress: SITE.address,
  emailHeading: 'Email',
  emailContent: 'RFQs and documents — we reply in 1–2 business days.',
  phoneHeading: 'Phone / WhatsApp',
  phoneContent: 'China mobile — WhatsApp and calls for export RFQs.',
};
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1 class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2 class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300">
          {copy.formTitle}
        </h2>
        <form action="/api/contact/" method="POST" data-rfq-form>
          {/* Honeypot — invisible to visitors, catches bots */}
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hidden"
          />
          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label
                  for="rfq-name"
                  class="mb-1.5 block text-sm font-semibold text-neutral-800 dark:text-neutral-200"
                >
                  {copy.name}
                  <span class="text-blue-600 dark:text-blue-400">*</span>
                </label>
                <input
                  id="rfq-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Your name"
                  class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm text-neutral-800 placeholder:text-neutral-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder:text-neutral-500"
                />
              </div>
              <div>
                <label
                  for="rfq-email"
                  class="mb-1.5 block text-sm font-semibold text-neutral-800 dark:text-neutral-200"
                >
                  {copy.email}
                  <span class="text-blue-600 dark:text-blue-400">*</span>
                </label>
                <input
                  id="rfq-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="you@company.com"
                  class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm text-neutral-800 placeholder:text-neutral-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder:text-neutral-500"
                />
              </div>
              <div>
                <label
                  for="rfq-company"
                  class="mb-1.5 block text-sm font-semibold text-neutral-800 dark:text-neutral-200"
                >
                  {copy.company}
                </label>
                <input
                  id="rfq-company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                  placeholder="Company name"
                  class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm text-neutral-800 placeholder:text-neutral-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder:text-neutral-500"
                />
              </div>
              <div>
                <label
                  for="rfq-topic"
                  class="mb-1.5 block text-sm font-semibold text-neutral-800 dark:text-neutral-200"
                >
                  {copy.topic}
                </label>
                <select
                  id="rfq-topic"
                  name="topic"
                  class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm text-neutral-800 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200"
                >
                  <option value="" disabled selected>
                    Select…
                  </option>
                  <option value="RFQ">Request a quote (RFQ)</option>
                  <option value="General question">General question</option>
                  <option value="Order in progress">Order in progress</option>
                  <option value="OEM / custom parts">OEM / custom parts</option>
                  <option value="Partnership / supplier inquiry">
                    Partnership / supplier inquiry
                  </option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
            <div>
              <label
                for="rfq-message"
                class="mb-1.5 block text-sm font-semibold text-neutral-800 dark:text-neutral-200"
              >
                {copy.message}
                <span class="text-blue-600 dark:text-blue-400">*</span>
              </label>
              <textarea
                id="rfq-message"
                name="message"
                rows="5"
                required
                placeholder="Size, material, quantity, destination port — one line per item"
                class="w-full rounded-lg border border-neutral-300 bg-white px-4 py-2.5 text-sm text-neutral-800 placeholder:text-neutral-400 focus:border-blue-500 focus:ring-1 focus:ring-blue-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-200 dark:placeholder:text-neutral-500"
              ></textarea>
            </div>
          </div>

          <div class="mt-4 grid">
            <AuthBtn title={copy.send} />
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {copy.formSubTitle}
            </p>
            <p
              class="mt-2 hidden text-sm text-blue-600 dark:text-blue-400"
              data-form-status
              data-success-message={copy.successMessage}
              aria-live="polite"
            ></p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.catalogHeading}
          content={copy.catalogContent}
          isLinkVisible={true}
          linkTitle={copy.catalogLink}
          linkURL="/products/"
          isArrowVisible={true}
        >
          <Icon name="question" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.faqHeading}
          content={copy.faqContent}
          isLinkVisible={true}
          linkTitle={copy.faqLink}
          linkURL="/faq/"
          isArrowVisible={true}
        >
          <Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeContent}
          isAddressVisible={true}
          addressContent={copy.officeAddress}
        >
          <Icon name="mapPin" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle={SITE.email}
          linkURL={`mailto:${SITE.email}`}
        >
          <Icon name="envelopeOpen" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.phoneHeading}
          content={copy.phoneContent}
          isLinkVisible={true}
          linkTitle={`WhatsApp ${SITE.phoneDisplay}`}
          linkURL={SITE.whatsappUrl}
          isArrowVisible={true}
        >
          <Icon name="whatsapp" />
        </ContactIconBlock>

        <ContactIconBlock
          heading="Call"
          content="Same number for voice calls."
          isLinkVisible={true}
          linkTitle={SITE.phoneDisplay}
          linkURL={`tel:${SITE.phone}`}
        >
          <Icon name="phone" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
