---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';

const copy = {
  formEndpoint: import.meta.env.PUBLIC_FORM_ENDPOINT || '',
  title: 'Request a Quote (RFQ)',
  subTitle:
    'Paste your size list — tube OD or thread, grade, quantity, destination port. A factory quote comes back in 1–2 business days: price, ship date, packing. No account, no charge, no obligation.',
  formTitle: 'RFQ form',
  formSubTitle:
    'One line per item is enough: size, material, quantity, port. Attach a drawing when the two ends differ.',
  firstName: 'First Name',
  lastName: 'Last Name',
  details: 'Size, material, quantity, destination, notes',
  send: 'Submit RFQ',
  demoMessage:
    `Thanks. This form is not connected yet — email ${SITE.email} and we reply to RFQs sent through the email form.`,
  catalogHeading: 'Product catalog',
  catalogContent:
    '105 stocked-and-quoted lines: compression fittings, ball valves, needle valves, corrugated hose.',
  catalogLink: 'View products',
  faqHeading: 'FAQ',
  faqContent:
    'Quick answers on materials, threads, MOQ and how RFQ ordering works.',
  faqLink: 'Visit FAQ',
  officeHeading: 'Factory address',
  officeContent:
    'FerruleX — Nanjing stainless steel fittings factory. Export RFQ and courier delivery.',
  officeAddress: SITE.address,
  emailHeading: 'Email us',
  emailContent: 'Prefer email? Write to',
};
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1 class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2 class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300">
          {copy.formTitle}
        </h2>
        <form
          action={copy.formEndpoint || '/contact/'}
          method="POST"
          data-demo-form={!copy.formEndpoint || undefined}
          data-demo-message={!copy.formEndpoint ? copy.demoMessage : undefined}
        >
          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput
                id="hs-firstname-contacts"
                label={copy.firstName}
                name="hs-firstname-contacts"
              />
              <TextInput
                id="hs-lastname-contacts"
                label={copy.lastName}
                name="hs-lastname-contacts"
              />
            </div>
            <EmailContactInput id="hs-email-contacts" />
            <PhoneInput id="hs-phone-number" />
            <TextAreaInput
              id="hs-about-contacts"
              label={copy.details}
              name="hs-about-contacts"
            />
          </div>

          <div class="mt-4 grid">
            <AuthBtn title={copy.send} />
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {copy.formSubTitle}
            </p>
            <p
              class="mt-2 hidden text-sm text-blue-600 dark:text-blue-400"
              data-demo-status
              aria-live="polite"
            ></p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.catalogHeading}
          content={copy.catalogContent}
          isLinkVisible={true}
          linkTitle={copy.catalogLink}
          linkURL="/products/"
          isArrowVisible={true}
        >
          <Icon name="question" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.faqHeading}
          content={copy.faqContent}
          isLinkVisible={true}
          linkTitle={copy.faqLink}
          linkURL="/faq/"
          isArrowVisible={true}
        >
          <Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeContent}
          isAddressVisible={true}
          addressContent={copy.officeAddress}
        >
          <Icon name="mapPin" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle={SITE.email}
          linkURL={`mailto:${SITE.email}`}
        >
          <Icon name="envelopeOpen" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
