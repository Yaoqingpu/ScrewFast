---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { SITE } from '@data/constants';

const copy = {
  title: 'Request a Quote (RFQ)',
  subTitle:
    'Paste your size list — tube OD or thread, grade, quantity, destination port. A factory quote comes back in 1–2 business days: price, ship date, packing. No account, no charge, no obligation.',
  formTitle: 'RFQ form',
  formSubTitle:
    'One line per item is enough: size, material, quantity, port. Attach a drawing when the two ends differ.',
  headerNote: 'Factory quote in 1–2 business days — no account, no obligation.',
  name: 'Name',
  email: 'Work Email',
  company: 'Company',
  topic: 'Topic',
  message: 'Size list / Message',
  send: 'Submit RFQ',
  successMessage:
    'Thanks — your RFQ is in the inbox. We reply in 1–2 business days.',
  catalogHeading: 'Product catalog',
  catalogContent:
    '105 stocked-and-quoted lines: compression fittings, ball valves, needle valves, corrugated hose.',
  catalogLink: 'View products',
  faqHeading: 'FAQ',
  faqContent:
    'Quick answers on materials, threads, MOQ and how RFQ ordering works.',
  faqLink: 'Visit FAQ',
  officeHeading: 'Factory address',
  officeContent:
    'FerruleX — Nanjing stainless steel fittings factory. Export RFQ and courier delivery.',
  officeAddress: SITE.address,
  emailHeading: 'Email',
  emailContent: 'RFQs and documents — we reply in 1–2 business days.',
  phoneHeading: 'Phone / WhatsApp',
  phoneContent: 'China mobile — WhatsApp and calls for export RFQs.',
};

const labelClass =
  'mb-1.5 block text-xs font-semibold uppercase tracking-wide text-neutral-500 dark:text-neutral-400';
const inputClass =
  'w-full rounded-xl border border-neutral-200 bg-white px-4 py-3 text-sm text-neutral-800 transition placeholder:text-neutral-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 focus:outline-none dark:border-neutral-700 dark:bg-neutral-950 dark:text-neutral-100 dark:placeholder:text-neutral-500';
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1 class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200">
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm ring-1 ring-neutral-900/5 dark:border-neutral-800 dark:bg-neutral-900 dark:ring-white/5">
        {/* Card header */}
        <div class="flex items-center gap-3 border-b border-neutral-100 bg-gradient-to-br from-blue-50 to-white px-6 py-5 sm:px-7 dark:border-neutral-800 dark:from-blue-950/40 dark:to-neutral-900">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-white shadow-sm shadow-blue-600/30">
            <svg
              class="size-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"></path>
            </svg>
          </span>
          <div>
            <h2 class="text-base font-bold text-neutral-900 dark:text-white">
              {copy.formTitle}
            </h2>
            <p class="mt-0.5 text-sm text-neutral-500 dark:text-neutral-400">
              {copy.headerNote}
            </p>
          </div>
        </div>

        <form
          action="/api/contact/"
          method="POST"
          data-rfq-form
          class="px-6 py-6 sm:px-7 sm:py-7"
        >
          {/* Honeypot — invisible to visitors, catches bots */}
          <input
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            class="hidden"
          />
          <div class="grid gap-5">
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
              <div>
                <label for="rfq-name" class={labelClass}>
                  {copy.name}
                  <span class="text-blue-600 dark:text-blue-400">*</span>
                </label>
                <input
                  id="rfq-name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Your name"
                  class={inputClass}
                />
              </div>
              <div>
                <label for="rfq-email" class={labelClass}>
                  {copy.email}
                  <span class="text-blue-600 dark:text-blue-400">*</span>
                </label>
                <input
                  id="rfq-email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="you@company.com"
                  class={inputClass}
                />
              </div>
              <div>
                <label for="rfq-company" class={labelClass}>
                  {copy.company}
                </label>
                <input
                  id="rfq-company"
                  name="company"
                  type="text"
                  autocomplete="organization"
                  placeholder="Company name"
                  class={inputClass}
                />
              </div>
              <div>
                <label for="rfq-topic" class={labelClass}>
                  {copy.topic}
                </label>
                <select id="rfq-topic" name="topic" class={inputClass}>
                  <option value="" disabled selected>
                    Select…
                  </option>
                  <option value="RFQ">Request a quote (RFQ)</option>
                  <option value="General question">General question</option>
                  <option value="Order in progress">Order in progress</option>
                  <option value="OEM / custom parts">OEM / custom parts</option>
                  <option value="Partnership / supplier inquiry">
                    Partnership / supplier inquiry
                  </option>
                  <option value="Other">Other</option>
                </select>
              </div>
            </div>
            <div>
              <label for="rfq-message" class={labelClass}>
                {copy.message}
                <span class="text-blue-600 dark:text-blue-400">*</span>
              </label>
              <textarea
                id="rfq-message"
                name="message"
                rows="5"
                required
                placeholder="Size, material, quantity, destination port — one line per item"
                class={inputClass}
              ></textarea>
              <p class="mt-1.5 text-xs text-neutral-500 dark:text-neutral-400">
                {copy.formSubTitle}
              </p>
            </div>
          </div>

          <div class="mt-6">
            <AuthBtn title={copy.send} />
          </div>

          <p
            class="mt-3 hidden text-center text-sm font-medium text-blue-600 dark:text-blue-400"
            data-form-status
            data-success-message={copy.successMessage}
            aria-live="polite"
          ></p>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.catalogHeading}
          content={copy.catalogContent}
          isLinkVisible={true}
          linkTitle={copy.catalogLink}
          linkURL="/products/"
          isArrowVisible={true}
        >
          <Icon name="question" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.faqHeading}
          content={copy.faqContent}
          isLinkVisible={true}
          linkTitle={copy.faqLink}
          linkURL="/faq/"
          isArrowVisible={true}
        >
          <Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeContent}
          isAddressVisible={true}
          addressContent={copy.officeAddress}
        >
          <Icon name="mapPin" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle={SITE.email}
          linkURL={`mailto:${SITE.email}`}
        >
          <Icon name="envelopeOpen" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.phoneHeading}
          content={copy.phoneContent}
          isLinkVisible={true}
          linkTitle={`WhatsApp ${SITE.phoneDisplay}`}
          linkURL={SITE.whatsappUrl}
          isArrowVisible={true}
        >
          <Icon name="whatsapp" />
        </ContactIconBlock>

        <ContactIconBlock
          heading="Call"
          content="Same number for voice calls."
          isLinkVisible={true}
          linkTitle={SITE.phoneDisplay}
          linkURL={`tel:${SITE.phone}`}
        >
          <Icon name="phone" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>
