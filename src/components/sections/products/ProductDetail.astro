---
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import ProductCard from '@components/ui/cards/ProductCard.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { getCategory, categoryPath } from '@data/categories';

interface Props {
  product: CollectionEntry<'products'>;
  related?: CollectionEntry<'products'>[];
}

const { product, related = [] } = Astro.props;
const category = getCategory(product.data.category);
const hasRealPhoto = !String(
  product.data.main.imgMain?.src ?? product.data.main.imgMain
).includes('placeholder');

const faqs = [
  {
    q: 'What should I send for a quote?',
    a: 'Size, material (SS304, SS316 or SS316L), quantity, end connection and destination. Add a sketch if the two ends are different.',
  },
  {
    q: 'How fast can this ship?',
    a: 'Stocked sizes usually leave 5–7 days after you confirm the quote. Make-to-order runs are about 15–25 days in production, then transit. Name the port if you want CIF.',
  },
  {
    q: 'Can I order a small trial or put my logo on it?',
    a: 'Yes. Trial quantities are quoted, and OEM marking or drawings are accepted. Payment is normally T/T with about 30% deposit, balance before shipment, or L/C at sight.',
  },
];
---

<section class="mx-auto flex max-w-6xl flex-col px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <nav class="mb-6 text-sm text-neutral-500 dark:text-neutral-400">
    <a href="/products/" class="hover:text-blue-700 dark:hover:text-blue-400">
      Products
    </a>
    {category && (
      <>
        <span class="mx-2">/</span>
        <a
          href={categoryPath(category.slug)}
          class="hover:text-blue-700 dark:hover:text-blue-400"
        >
          {category.shortTitle}
        </a>
      </>
    )}
    <span class="mx-2">/</span>
    <span class="text-neutral-800 dark:text-neutral-200">
      {product.data.title}
    </span>
  </nav>
  <div class="grid items-start gap-8 lg:grid-cols-[26rem_1fr] lg:gap-12">
    <div
      class="relative mx-auto w-full max-w-sm overflow-hidden rounded-2xl bg-neutral-100 p-4 shadow-lg shadow-neutral-900/5 ring-1 ring-neutral-900/10 lg:max-w-none dark:bg-neutral-800 dark:ring-neutral-100/10"
      style={!hasRealPhoto ? 'padding: 2.5rem' : undefined}
    >
      <Image
        src={product.data.main.imgMain}
        class="aspect-square w-full object-contain"
        alt={product.data.main.imgAlt}
        format={'avif'}
        loading={'eager'}
        widths={[320, 480, 640]}
        sizes="(max-width: 1024px) 384px, 416px"
        width={480}
        height={480}
      />
    </div>
    <div>
      <h1 class="text-3xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-200">
        {product.data.title}
      </h1>
      <p class="mt-3 text-neutral-600 dark:text-neutral-400">
        {product.data.description}
      </p>
      <dl class="mt-6 divide-y divide-neutral-200 rounded-xl border border-neutral-200 bg-white dark:divide-neutral-700 dark:border-neutral-700 dark:bg-neutral-900">
        {product.data.specificationsLeft.map(spec => (
          <div class="grid grid-cols-[8rem_1fr] gap-3 px-4 py-3 text-sm">
            <dt class="font-semibold text-neutral-800 dark:text-neutral-200">
              {spec.title}
            </dt>
            <dd class="text-neutral-600 dark:text-neutral-400">
              {spec.subTitle}
            </dd>
          </div>
        ))}
      </dl>
      <p class="mt-6">
        <PrimaryCTA
          title={product.data.longDescription.btnTitle}
          url={product.data.longDescription.btnURL}
        />
      </p>
    </div>
  </div>
  <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <li class="flex gap-3 rounded-xl bg-white p-4 ring-1 ring-neutral-200 dark:bg-neutral-900 dark:ring-neutral-700">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-400/10 dark:text-blue-400">
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 6v6l4 2"
          />
          <circle cx="12" cy="12" r="9" />
        </svg>
      </span>
      <div>
        <span class="block text-sm font-semibold text-neutral-800 dark:text-neutral-200">
          Stock
        </span>
        <span class="mt-0.5 block text-sm text-neutral-600 dark:text-neutral-400">
          5–7 days after confirmation
        </span>
      </div>
    </li>
    <li class="flex gap-3 rounded-xl bg-white p-4 ring-1 ring-neutral-200 dark:bg-neutral-900 dark:ring-neutral-700">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-400/10 dark:text-blue-400">
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3 21h18M5 21V10l7-6 7 6v11M9 21v-6h6v6"
          />
        </svg>
      </span>
      <div>
        <span class="block text-sm font-semibold text-neutral-800 dark:text-neutral-200">
          Make to order
        </span>
        <span class="mt-0.5 block text-sm text-neutral-600 dark:text-neutral-400">
          15–25 days production
        </span>
      </div>
    </li>
    <li class="flex gap-3 rounded-xl bg-white p-4 ring-1 ring-neutral-200 dark:bg-neutral-900 dark:ring-neutral-700">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-400/10 dark:text-blue-400">
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <rect x="2.5" y="5" width="19" height="14" rx="2" />
          <path stroke-linecap="round" d="M2.5 10h19" />
        </svg>
      </span>
      <div>
        <span class="block text-sm font-semibold text-neutral-800 dark:text-neutral-200">
          Payment / terms
        </span>
        <span class="mt-0.5 block text-sm text-neutral-600 dark:text-neutral-400">
          T/T ~30% or L/C · FOB Shanghai / Ningbo
        </span>
      </div>
    </li>
    <li class="flex gap-3 rounded-xl bg-white p-4 ring-1 ring-neutral-200 dark:bg-neutral-900 dark:ring-neutral-700">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-400/10 dark:text-blue-400">
        <svg
          class="h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M12 3l2.2 4.6L19 8.2l-3.5 3.4.8 4.9L12 14.8 7.7 16.5l.8-4.9L5 8.2l4.8-.6L12 3z"
          />
        </svg>
      </span>
      <div>
        <span class="block text-sm font-semibold text-neutral-800 dark:text-neutral-200">
          OEM
        </span>
        <span class="mt-0.5 block text-sm text-neutral-600 dark:text-neutral-400">
          Logo and drawings accepted · price on RFQ
        </span>
      </div>
    </li>
  </ul>
  {!hasRealPhoto && (
    <p class="mx-auto mt-4 max-w-md rounded-lg bg-neutral-100 px-4 py-3 text-center text-sm text-neutral-500 dark:bg-neutral-800 dark:text-neutral-400">
      Product photo coming soon — ask us for a current photo with your RFQ.
    </p>
  )}
</section>

<div class="mx-auto max-w-6xl space-y-12 px-4 pb-16 sm:px-6 lg:px-8 lg:pb-24">
  <section>
    <h2 class="flex items-center gap-3 text-2xl font-bold tracking-tight text-neutral-800 md:text-3xl dark:text-neutral-200">
      <span class="h-6 w-1 rounded-full bg-blue-600" aria-hidden="true"></span>
      Description
    </h2>
    <p class="mt-4 text-neutral-600 dark:text-neutral-400">
      {product.data.main.content}
    </p>
    <p class="mt-4 text-neutral-600 dark:text-neutral-400">
      {product.data.longDescription.subTitle}
    </p>
    <dl class="mt-8 grid gap-4 sm:grid-cols-3">
      {product.data.descriptionList.map((list, index) => (
        <div class="rounded-xl border border-neutral-200 bg-white p-4 dark:border-neutral-700 dark:bg-neutral-900">
          <span class="mb-3 flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600 dark:bg-blue-400/10 dark:text-blue-400">
            {index % 3 === 0 && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 12l8-4.5M12 12v9M12 12L4 7.5"
                />
              </svg>
            )}
            {index % 3 === 1 && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M4 8h11M4 8l4-4M4 8l4 4M20 16H9M20 16l-4-4M20 16l-4 4"
                />
              </svg>
            )}
            {index % 3 === 2 && (
              <svg
                class="h-5 w-5"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M9 12l2 2 4-4"
                />
                <circle cx="12" cy="12" r="9" />
              </svg>
            )}
          </span>
          <dt class="font-bold text-neutral-800 dark:text-neutral-200">
            {list.title}
          </dt>
          <dd class="mt-1 text-sm text-neutral-600 dark:text-neutral-400">
            {list.subTitle}
          </dd>
        </div>
      ))}
    </dl>
  </section>

  <section>
    <h2 class="flex items-center gap-3 text-2xl font-bold tracking-tight text-neutral-800 md:text-3xl dark:text-neutral-200">
      <span class="h-6 w-1 rounded-full bg-blue-600" aria-hidden="true"></span>
      Specifications
    </h2>
    <div class="mt-6 overflow-x-auto rounded-xl border border-neutral-200 dark:border-neutral-700">
      <table class="min-w-full divide-y divide-neutral-200 dark:divide-neutral-700">
        <thead class="bg-neutral-50 dark:bg-neutral-800/60">
          <tr>
            {(
              product.data.tableData?.[0]?.feature ?? ['Specification', 'Value']
            ).map(header => (
              <th
                scope="col"
                class="px-6 py-3 text-start text-xs font-medium tracking-wide text-neutral-500 uppercase"
              >
                {header}
              </th>
            ))}
          </tr>
        </thead>
        <tbody class="divide-y divide-neutral-200 dark:divide-neutral-700">
          {product.data.tableData
            ? product.data.tableData.map(row =>
                row.description.map(rowData => (
                  <tr>
                    {rowData.map(cellValue => (
                      <td class="px-6 py-4 text-sm text-neutral-700 dark:text-neutral-300">
                        {cellValue}
                      </td>
                    ))}
                  </tr>
                ))
              )
            : product.data.specificationsLeft.map(spec => (
                <tr>
                  <td class="px-6 py-4 text-sm font-medium text-neutral-800 dark:text-neutral-200">
                    {spec.title}
                  </td>
                  <td class="px-6 py-4 text-sm text-neutral-700 dark:text-neutral-300">
                    {spec.subTitle}
                  </td>
                </tr>
              ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="relative overflow-hidden rounded-2xl bg-neutral-900 px-6 py-10 shadow-xl shadow-neutral-900/20 sm:px-10 dark:ring-1 dark:ring-neutral-800">
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:url(/banner-pattern.svg)] [background-size:28px_28px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-neutral-900/60 via-transparent to-transparent"
      aria-hidden="true"
    ></div>
    <div class="relative">
      <h2 class="flex items-center gap-3 text-2xl font-bold tracking-tight text-white">
        Request Quote
      </h2>
      <p class="mt-3 max-w-2xl text-neutral-300">
        Prices stay on the RFQ. Send size, material, quantity and destination —
        the factory replies with price, lead time and packing.
      </p>
      <p class="mt-5">
        <PrimaryCTA
          title={product.data.longDescription.btnTitle}
          url={product.data.longDescription.btnURL}
        />
      </p>
    </div>
  </section>

  <section>
    <h2 class="flex items-center gap-3 text-2xl font-bold tracking-tight text-neutral-800 md:text-3xl dark:text-neutral-200">
      <span class="h-6 w-1 rounded-full bg-blue-600" aria-hidden="true"></span>
      Shipping &amp; packing
    </h2>
    <p class="mt-4 max-w-3xl text-neutral-600 dark:text-neutral-400">
      Parts ship in a bag, inner carton and export carton. Large lots can go in
      a wooden case with a packing list and invoice. Default term is FOB
      Shanghai or Ningbo. Full notes are on the
      <a class="text-blue-700 underline" href="/delivery/">
        delivery page
      </a>
      .
    </p>
  </section>

  <section>
    <h2 class="flex items-center gap-3 text-2xl font-bold tracking-tight text-neutral-800 md:text-3xl dark:text-neutral-200">
      <span class="h-6 w-1 rounded-full bg-blue-600" aria-hidden="true"></span>
      Questions buyers ask
    </h2>
    <div class="mt-6 space-y-4">
      {faqs.map(item => (
        <details
          class="rounded-xl border border-neutral-200 px-4 py-3 dark:border-neutral-700"
          open
        >
          <summary class="cursor-pointer font-semibold text-neutral-800 dark:text-neutral-200">
            {item.q}
          </summary>
          <p class="mt-2 text-neutral-600 dark:text-neutral-400">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  {related.length > 0 && (
    <section>
      <h2 class="flex items-center gap-3 text-2xl font-bold tracking-tight text-neutral-800 md:text-3xl dark:text-neutral-200">
        <span
          class="h-6 w-1 rounded-full bg-blue-600"
          aria-hidden="true"
        ></span>
        Related products
      </h2>
      <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {related.map(item => (
          <ProductCard product={item} />
        ))}
      </div>
    </section>
  )}
</div>
