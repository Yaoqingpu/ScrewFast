---
/**
 * FerruleX wordmark + mark (double-ferrule rings + X accent).
 * Inherits text color via currentColor for light/dark navbar.
 */
const { class: className, ...rest } = Astro.props;
---

<svg
  {...rest}
  class={className}
  viewBox="0 0 248 48"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-label="FerruleX"
  role="img"
>
  <title>FerruleX</title>
  {/* Mark: concentric ferrule rings + X */}
  <g transform="translate(0, 4)">
    <circle
      cx="20"
      cy="20"
      r="18"
      class="stroke-current text-neutral-800 dark:text-neutral-100"
      stroke-width="3.5"
      fill="none"
    />
    <circle
      cx="20"
      cy="20"
      r="11.5"
      class="stroke-current text-neutral-500 dark:text-neutral-400"
      stroke-width="2.5"
      fill="none"
    />
    <circle
      cx="20"
      cy="20"
      r="5.5"
      class="stroke-current text-neutral-800 dark:text-neutral-100"
      stroke-width="1.75"
      fill="none"
    />
    {/* gaps on sides like ferrule nut flats */}
    <path
      d="M2 18.5h5M33 18.5h5M2 21.5h5M33 21.5h5"
      class="stroke-current text-neutral-300 dark:text-neutral-700"
      stroke-width="2.5"
      stroke-linecap="butt"
    />
    {/* X arms */}
    <path
      d="M20 6.5 L20 33.5 M6.5 20 L33.5 20"
      class="stroke-current text-neutral-800 dark:text-neutral-100"
      stroke-width="3.2"
      stroke-linecap="square"
      transform="rotate(45 20 20)"
    />
    <rect
      x="16.5"
      y="16.5"
      width="7"
      height="7"
      rx="0.5"
      class="fill-current text-blue-600 dark:text-blue-400"
    />
  </g>
  {/* Wordmark */}
  <text
    x="52"
    y="33"
    class="fill-current text-neutral-800 dark:text-neutral-100"
    font-family="ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif"
    font-size="26"
    font-weight="700"
    letter-spacing="-0.03em"
  >
    FerruleX
  </text>
</svg>
